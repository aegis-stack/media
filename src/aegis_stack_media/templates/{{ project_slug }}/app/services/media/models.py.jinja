"""Tables for the media service.

Two of them. One row per conversion asked for: the profile, the source
object's key, and - once it has run - the result's key and size; the row is
the job's own record, so the page can show what happened without a second
store, and the bucket holds the bytes.

And one row per profile this project has *changed*: the shipped
``profiles.yml`` says what a profile is out of the box, this table says what
this project made it. Editing a profile is a setting, so it belongs in the
database beside every other setting - not in a file rewritten at runtime.

The source is content-addressed by ``app.core.storage``: the same upload
twice is one object, and two rows can point at it.
"""

from __future__ import annotations

from datetime import datetime

from sqlmodel import Field, SQLModel

from app.core.time import utcnow


class MediaJob(SQLModel, table=True):
    """One conversion: a source object, a profile, and what came back."""

    __tablename__ = "media_job"
{%- if database_engine == "postgres" %}
    __table_args__ = {"schema": "media"}
{%- endif %}

    id: int | None = Field(default=None, primary_key=True)
    profile: str = Field(max_length=64, nullable=False, index=True)
    source_key: str = Field(max_length=128, nullable=False)
    source_name: str | None = Field(default=None, max_length=255)
    source_bytes: int = Field(default=0)
    # This job's own trim, "the first ``end`` seconds" or, negative like
    # ffmpeg's ``-sseof``, the last; in place of the profile's. Empty is the
    # profile's own (the whole file, as shipped).
    end: float | None = Field(default=None)
    output_key: str | None = Field(default=None, max_length=128)
    output_bytes: int | None = Field(default=None)
    content_type: str | None = Field(default=None, max_length=64)
    # queued -> running -> done | failed. The page polls the row, which is
    # why the status is here and not only in the framework's job store.
    status: str = Field(default="queued", max_length=16, nullable=False, index=True)
    error: str | None = Field(default=None, max_length=1000)
    created_at: datetime = Field(default_factory=utcnow, nullable=False, index=True)
    finished_at: datetime | None = Field(default=None)

    @property
    def has_result(self) -> bool:
        """Done, and what it made is still stored (not deleted since)."""
        return self.status == "done" and bool(self.output_key)


class MediaProfile(SQLModel, table=True):
    """What this project changed about one shipped profile.

    Every column is optional: absent means "as shipped", and a NULL column
    keeps the shipped value for that one setting. The name is the profile's
    name in ``profiles.yml``, so the file stays the vocabulary - adding a
    profile is still a data edit, and this table only tunes the ones that
    exist.
    """

    __tablename__ = "media_profile"
{%- if database_engine == "postgres" %}
    __table_args__ = {"schema": "media"}
{%- endif %}

    name: str = Field(primary_key=True, max_length=64)
    description: str | None = Field(default=None, max_length=255)
    fps: int | None = Field(default=None)
    width: int | None = Field(default=None)
    max_bytes: int | None = Field(default=None)
    bitrate: str | None = Field(default=None, max_length=16)
    at: float | None = Field(default=None)
    crf: int | None = Field(default=None)
    start: float | None = Field(default=None)
    end: float | None = Field(default=None)
    updated_at: datetime = Field(default_factory=utcnow, nullable=False)
